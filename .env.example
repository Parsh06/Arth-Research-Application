# ==============================================================================
# ARTH RESEARCH APPLICATION - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT: Never commit actual keys, passwords, or secrets to GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Firebase Client SDK)
# Used on Firebase Hosting & Local Vite Frontend
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_MEASUREMENT_ID="your-measurement-id"

# Razorpay Public Key ID (Frontend checkout modal)
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# Anti-Debugging & Security Guard (Set to 'true' in production to disable right-click, F12, DevTools)
VITE_NETWORK_SECURITY_GUARD="false"

# Backend API URL (Optional in local dev, set to Vercel backend URL in production)
# Example: https://your-backend.vercel.app
VITE_API_URL=""

# ------------------------------------------------------------------------------
# BACKEND SERVERLESS CONFIGURATION (Vercel Functions / Node.js)
# Configure these in your Vercel Dashboard -> Project Settings -> Environment Variables
# ------------------------------------------------------------------------------

# Razorpay Test / Live Secret (Server-side order creation & HMAC verification)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_key"

# Gmail SMTP Email Dispatch (Server-side email delivery via nodemailer)
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-gmail-app-password"

# Cron Job Secret Authorization (Used by cron-job.org or Vercel Cron)
CRON_SECRET="your-custom-cron-secret-token"

