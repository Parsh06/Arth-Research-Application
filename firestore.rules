rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // CRYPTOGRAPHIC RBAC & AUTH HELPERS
    // ============================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }


    function isAdmin() {
      return isAuthenticated() &&
             getUserData().get('role', 'user') in ['super_admin', 'admin', 'research_admin', 'support_admin'];
    }

    function isSupportOrAdmin() {
      return isAuthenticated() &&
             getUserData().get('role', 'user') in ['super_admin', 'admin', 'support_admin', 'research_admin'];
    }

    // Ensures the authenticated user's account is not revoked, suspended, or disabled
    function isUserActive() {
      return isAuthenticated() &&
             getUserData().get('status', 'active') != 'revoked' &&
             getUserData().get('status', 'active') != 'suspended' &&
             getUserData().get('status', 'active') != 'disabled';
    }

    // Ensures the authenticated user holds an active quantitative subscription or is admin
    function isSubscriber() {
      return isAuthenticated() &&
             (getUserData().get('subscriptionStatus', 'inactive') == 'active' || isAdmin());
    }

    // ============================================================================
    // USER IDENTITY & DOMAIN SEGREGATION
    // ============================================================================

    match /users/{userId} {
      // Anyone authenticated can read their own profile; admins can read all
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      // Self-create on first login
      allow create: if isAuthenticated() && request.auth.uid == userId
                    && request.resource.data.get('role', 'user') == 'user'
                    && request.resource.data.get('status', 'active') == 'active';

      // ZERO-TRUST LOCKDOWN: Users can update their profile, but CANNOT escalate privileges
      // (cannot self-assign role or account status)
      allow update: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'status'])
      );

      // Only admins can delete user documents
      allow delete: if isAdmin();
    }

    // Private PII: phone, address, bank details — user can read/write own; admin read-only
    match /userPrivate/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Users update their own private data; admins cannot write (prevents admin from spoofing PII)
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Regulatory Compliance & Risk Profiling — user can read/write own; admin read-only
    match /userCompliance/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Users submit their own KYC/compliance data; admins cannot write from client
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false; // Compliance records are never deleted
    }

    // ============================================================================
    // ADVISORY CATALOG & INSTRUMENTS
    // ============================================================================

    // Plans are public — any visitor may browse the advisory catalog
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Promotional Discount Vouchers & Coupons — Users READ-ONLY; creation & updates handled by admin/backend
    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Instruments require authentication (protects stock universe from scraping)
    match /instruments/{instrumentId} {
      allow read: if isUserActive() || isAdmin();
      allow write: if isAdmin();
    }

    // Proprietary Research Content — Restricted to active subscribers and quantitative desk admins
    match /research_content/{contentId} {
      allow read: if isSubscriber();
      allow write: if isAdmin();
    }

    // Legacy alias
    match /researchCalls/{callId} {
      allow read: if isSubscriber();
      allow write: if isAdmin();
    }

    // ============================================================================
    // PORTFOLIO LIFECYCLE & MULTI-TENANT ISOLATION
    // ============================================================================

    match /portfolios/{portfolioId} {
      // Helper function to verify portfolio ownership
      function isPortfolioOwner() {
        return resource.data.userId == request.auth.uid;
      }

      // Owner or admin can read root portfolio document
      allow read: if isAuthenticated() && (isPortfolioOwner() || isAdmin());

      // Owner can create their own portfolio
      allow create: if isUserActive()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';

      // Owner can update (resubmit); admin can update (approve/reject)
      // Users cannot flip status to 'active' or 'approved' themselves
      allow update: if isAdmin()
                    || (isUserActive()
                        && isPortfolioOwner()
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'holdings', 'totalInvestmentMinor',
                                     'stockCount', 'currentVersionId', 'submittedAt',
                                     'updatedAt', 'rejectionReason'])
                        && request.resource.data.status == 'pending');

      allow delete: if isAdmin();

      // Version Snapshots — Strictly scoped to portfolio owner or admin
      match /versions/{versionId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/portfolios/$(portfolioId)).data.userId == request.auth.uid
          || isAdmin()
        );
        allow create: if isUserActive() && (
          get(/databases/$(database)/documents/portfolios/$(portfolioId)).data.userId == request.auth.uid
          || isAdmin()
        );
        // Versions are immutable once created — no updates or deletes
        allow update, delete: if false;
      }

      // Holdings Subcollection — STRICT MULTI-TENANT ISOLATION
      // Only the portfolio owner or an admin can read/write holdings in this portfolio
      match /holdings/{holdingId} {
        allow read, write: if isAuthenticated() && (
          get(/databases/$(database)/documents/portfolios/$(portfolioId)).data.userId == request.auth.uid
          || isAdmin()
        );
      }
    }

    // ============================================================================
    // COMMERCE — ORDERS, PAYMENTS & SUBSCRIPTIONS (SERVER-MANAGED)
    // ============================================================================

    // Orders — Users can read their own; can create their own verified order record
    match /orders/{orderId} {
      allow read: if isAuthenticated()
                  && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Payment Records — Users can read their own; can create their own verified payment record
    match /payments/{paymentId} {
      allow read: if isAuthenticated()
                  && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Subscriptions — Users can read their own; can create their own verified subscription record
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated()
                  && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Entitlements — Users can read their own; can create/update their own entitlement records
    match /entitlements/{entitlementId} {
      allow read: if isAuthenticated()
                  && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ============================================================================
    // NOTIFICATIONS
    // ============================================================================

    match /notifications/{notificationId} {
      // Users read their own; admins read all
      allow read: if isAuthenticated()
                  && (resource.data.userId == request.auth.uid || isAdmin());

      // Users can only mark as read — cannot change type, message, or userId
      allow update: if isAuthenticated()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['isRead', 'readAt']);

      // Notifications are created and deleted by admin/system only
      allow create, delete: if isAdmin();
    }

    // ============================================================================
    // SUPPORT & HELPDESK
    // ============================================================================

    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated()
                  && (resource.data.userId == request.auth.uid || isSupportOrAdmin());

      // User creates their own ticket with bounded payload sizes to prevent storage exhaustion
      allow create: if isUserActive()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.subject.size() <= 200
                    && request.resource.data.message.size() <= 4000;

      // Users cannot change ticket status or assigned staff; they can only update timestamp
      allow update: if isSupportOrAdmin() || (
        isUserActive()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['updatedAt', 'lastMessageAt'])
      );

      allow delete: if isAdmin();

      // Messages subcollection — scoped to ticket owner or support/admin with bounds
      match /messages/{messageId} {
        allow read: if isAuthenticated()
                    && (get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId
                        == request.auth.uid || isSupportOrAdmin());
        allow create: if isUserActive()
                      && (get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId
                          == request.auth.uid || isSupportOrAdmin())
                      && request.resource.data.message.size() <= 4000;
        // Messages are immutable once sent
        allow update, delete: if false;
      }
    }

    // Processed Webhook & Payment Idempotency Ledger
    match /processed_webhook_events/{eventId} {
      allow read, write: if isAdmin();
    }

    // Legacy collection name alias
    match /tickets/{ticketId} {
      allow read: if isAuthenticated()
                  && (resource.data.userId == request.auth.uid || isSupportOrAdmin());
      allow create: if isUserActive()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isSupportOrAdmin();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated()
                    && (get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId
                        == request.auth.uid || isSupportOrAdmin());
        allow create: if isUserActive()
                      && (get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId
                          == request.auth.uid || isSupportOrAdmin());
        allow update, delete: if false;
      }
    }

    // ============================================================================
    // CMS CONTENT
    // ============================================================================

    // CMS is publicly readable; only admin can edit
    match /cms_content/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Legacy alias
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================================
    // SYSTEM GOVERNANCE & REGULATORY AUDIT LOGS (TAMPER-EVIDENT)
    // ============================================================================

    match /auditLogs/{logId} {
      // Admin can read audit logs
      allow read: if isAdmin();
      // Only privileged backend or admin can create audit log entries
      allow create: if isAdmin();
      // Audit logs cannot be modified
      allow update: if false;
      // Admin can purge audit logs
      allow delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
