rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // CRYPTOGRAPHIC RBAC & AUTH HELPERS
    // ============================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
             getUserData().get('role', 'user') == 'super_admin';
    }

    function isAdmin() {
      return isAuthenticated() &&
             getUserData().get('role', 'user') in ['super_admin', 'admin', 'research_admin', 'support_admin'];
    }

    function isSupportOrAdmin() {
      return isAuthenticated() &&
             getUserData().get('role', 'user') in ['super_admin', 'admin', 'support_admin', 'research_admin'];
    }

    // Ensures the authenticated user's account is not revoked, suspended, or disabled
    function isUserActive() {
      return isAuthenticated() &&
             getUserData().get('status', 'active') != 'revoked' &&
             getUserData().get('status', 'active') != 'suspended' &&
             getUserData().get('status', 'active') != 'disabled';
    }

    // ============================================================================
    // USER IDENTITY & DOMAIN SEGREGATION
    // ============================================================================

    match /users/{userId} {
      // Anyone authenticated can read their own profile; admins can read all
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      // Self-create on first login only
      allow create: if isAuthenticated() && request.auth.uid == userId
                    && request.resource.data.role == 'user'
                    && request.resource.data.status == 'active';

      // Users can update safe profile fields and subscription state on checkout completion
      allow update: if isAuthenticated() && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['displayName', 'phone', 'photoURL', 'updatedAt',
                                 'subscriptionStatus', 'activePlanId', 'activePlanName', 'subscriptionExpiresAt'])
                    || isAdmin();

      // Only admins can delete user documents
      allow delete: if isAdmin();
    }

    // Private PII: phone, address, bank details — user can read/write own; admin read-only
    match /userPrivate/{userId} {
      allow read: if isUserActive() && (request.auth.uid == userId || isAdmin());
      // Users update their own private data; admins cannot write (prevents admin from spoofing PII)
      allow write: if isUserActive() && request.auth.uid == userId;
    }

    // Regulatory Compliance & Risk Profiling — user can read/write own; admin read-only
    match /userCompliance/{userId} {
      allow read: if isUserActive() && (request.auth.uid == userId || isAdmin());
      // Users submit their own KYC/compliance data; admins cannot write from client
      allow create, update: if isUserActive() && request.auth.uid == userId;
      allow delete: if false; // Compliance records are never deleted
    }

    // ============================================================================
    // ADVISORY CATALOG & INSTRUMENTS
    // ============================================================================

    // Plans are public — any visitor may browse the advisory catalog
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Promotional Discount Vouchers & Coupons
    match /coupons/{couponId} {
      // Authenticated users can read/query coupons to validate checkout discounts
      allow read: if isAuthenticated();
      // Admins have full write control; authenticated users can increment timesUsed during checkout
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timesUsed', 'updatedAt'])
      );
    }

    // Instruments require authentication (protects stock universe from scraping)
    match /instruments/{instrumentId} {
      allow read: if isUserActive() || isAdmin();
      allow write: if isAdmin();
    }

    // Research Content — readable by authenticated users (content visibility gated at UI layer)
    match /research_content/{contentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Legacy alias — kept for backwards compatibility
    match /researchCalls/{callId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================================================
    // PORTFOLIO LIFECYCLE & IMMUTABLE VERSIONS
    // ============================================================================

    match /portfolios/{portfolioId} {
      // Owner or admin can read root portfolio document
      allow read: if isAuthenticated()
                  && (resource.data.userId == request.auth.uid || isAdmin());

      // Owner can create their own portfolio
      allow create: if isUserActive()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';

      // Owner can update (resubmit); admin can update (approve/reject)
      // Users cannot flip status to 'active' or 'approved' themselves
      allow update: if isAdmin()
                    || (isUserActive()
                        && resource.data.userId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'holdings', 'totalInvestmentMinor',
                                     'stockCount', 'currentVersionId', 'submittedAt',
                                     'updatedAt', 'rejectionReason'])
                        && request.resource.data.status == 'pending');

      allow delete: if isAdmin();

      // Version Snapshots — immutable audit trail; owner & admin read; authenticated create
      match /versions/{versionId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        // Versions are immutable once created — no updates or deletes
        allow update, delete: if false;
      }

      // Holdings Subcollection — scoped to portfolio owner or admin
      match /holdings/{holdingId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    // ============================================================================
    // COMMERCE — ORDERS, PAYMENTS & SUBSCRIPTIONS
    // ============================================================================

    match /orders/{orderId} {
      // Owner or admin can read
      allow read: if isAuthenticated()
                  && (resource.data.userId == request.auth.uid || isAdmin());

      // Client can create their own order
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;

      // Admin can update any order; owner can update during payment completion/failure
      // NOTE: affectedKeys must include every field written by completePaymentAndProvision()
      allow update: if isAdmin()
                    || (isUserActive()
                        && resource.data.userId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly([
                             // Core status fields
                             'status', 'updatedAt', 'paidAt', 'failureReason',
                             // Gateway identifiers
                             'gatewayPaymentId', 'gatewayOrderId', 'gatewaySignature',
                             'invoiceNumber',
                             // Customer
                             'userPhone',
                             // Payment instrument — basic
                             'paymentMode', 'paymentMethod', 'bank', 'wallet', 'vpa',
                             // Payment instrument — card details
                             'cardNetwork', 'cardLast4', 'cardName', 'cardIssuer',
                             'cardType', 'cardSubType', 'cardInternational',
                             // EMI & international
                             'emiDuration', 'international',
                             // Razorpay platform fees
                             'razorpayFeeMinor', 'razorpayTaxMinor',
                             // Acquirer / bank data
                             'acquirerAuthCode', 'acquirerBankTxnId',
                             'acquirerRrn', 'acquirerUpiTxnId',
                             // Error diagnostics (failed payments)
                             'errorCode', 'errorDescription', 'errorSource',
                             'errorStep', 'errorReason',
                             // Refund tracking
                             'refundId', 'refundedAt', 'refundStatus', 'refundAmountMinor',
                             // Coupons & discounts
                             'couponCode', 'discountMinor'
                           ]));

      allow delete: if false; // Financial records are never deleted
    }

    match /payments/{paymentId} {
      // Owner or admin can read
      allow read: if isAuthenticated()
                  && (resource.data.userId == request.auth.uid || isAdmin());

      // Payment records can be created by authenticated user for their order
      allow create: if isAuthenticated();

      // Only admin can update or delete payment records
      allow update, delete: if isAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated()
                  && (resource.data.userId == request.auth.uid || isAdmin());

      // Subscriptions are created by the payment service on order completion or by admin during reconciliation
      allow create: if isAuthenticated()
                    && (request.resource.data.userId == request.auth.uid || isAdmin())
                    && request.resource.data.status == 'active';

      // Users CANNOT modify subscription fields — no status spoofing
      // Only admin can update (extend, cancel mandate)
      allow update: if isAdmin();

      allow delete: if false; // Subscription records are never deleted
    }

    // Entitlements — Document ID is always "{userId}_{featureKey}"
    // Users can read their own; only system/admin can write
    match /entitlements/{entitlementId} {
      allow read: if isAuthenticated()
                  && (resource.data.userId == request.auth.uid
                      || entitlementId.matches(request.auth.uid + '_.*')
                      || isAdmin());

      allow create: if isAuthenticated()
                    && (request.resource.data.userId == request.auth.uid
                        || entitlementId.matches(request.auth.uid + '_.*')
                        || isAdmin());

      allow update: if isAdmin()
                    || (isAuthenticated()
                        && (resource.data.userId == request.auth.uid
                            || entitlementId.matches(request.auth.uid + '_.*')));

      allow delete: if isAdmin();
    }

    // ============================================================================
    // NOTIFICATIONS
    // ============================================================================

    match /notifications/{notificationId} {
      // Users read their own; admins read all
      allow read: if isAuthenticated()
                  && (resource.data.userId == request.auth.uid || isAdmin());

      // Users can only mark as read — cannot change type, message, or userId
      allow update: if isAuthenticated()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['isRead', 'readAt']);

      // Notifications are created and deleted by admin/system only
      allow create, delete: if isAdmin();
    }

    // ============================================================================
    // SUPPORT & HELPDESK
    // ============================================================================

    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated()
                  && (resource.data.userId == request.auth.uid || isSupportOrAdmin());

      // User creates their own ticket with bounded payload sizes to prevent storage exhaustion
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.subject.size() <= 200
                    && request.resource.data.message.size() <= 4000;

      // User can add replies; support/admin can update status
      allow update: if isAuthenticated()
                    && (resource.data.userId == request.auth.uid || isSupportOrAdmin());

      allow delete: if isAdmin();

      // Messages subcollection — scoped to ticket owner or support/admin with bounds
      match /messages/{messageId} {
        allow read: if isAuthenticated()
                    && (get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId
                        == request.auth.uid || isSupportOrAdmin());
        allow create: if isAuthenticated()
                      && (get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId
                          == request.auth.uid || isSupportOrAdmin())
                      && request.resource.data.message.size() <= 4000;
        // Messages are immutable once sent
        allow update, delete: if false;
      }
    }

    // Processed Webhook & Payment Idempotency Ledger
    match /processed_webhook_events/{eventId} {
      allow read, write: if isAdmin();
    }

    // Legacy collection name alias
    match /tickets/{ticketId} {
      allow read: if isAuthenticated()
                  && (resource.data.userId == request.auth.uid || isSupportOrAdmin());
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
                    && (resource.data.userId == request.auth.uid || isSupportOrAdmin());
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated()
                    && (get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId
                        == request.auth.uid || isSupportOrAdmin());
        allow create: if isAuthenticated()
                      && (get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId
                          == request.auth.uid || isSupportOrAdmin());
        allow update, delete: if false;
      }
    }

    // ============================================================================
    // CMS CONTENT
    // ============================================================================

    // CMS is publicly readable; only admin can edit
    match /cms_content/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Legacy alias
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================================
    // SYSTEM GOVERNANCE & REGULATORY AUDIT LOGS (TAMPER-EVIDENT)
    // ============================================================================

    match /auditLogs/{logId} {
      // Admin can read audit logs
      allow read: if isAdmin();
      // Admin or authenticated actions can create audit log entries
      allow create: if isAuthenticated();
      // Audit logs cannot be modified
      allow update: if false;
      // Admin can purge audit logs
      allow delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
